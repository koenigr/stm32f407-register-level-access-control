TEST_F(ExtiTest, NvicEnableIrq23SetsIser0Bit23) {
	EXTI_NVIC_Enable(23);

	EXPECT_EQ(test_nvic_iser[0], 1U << 23);
	EXPECT_EQ(test_nvic_iser[1], 0U);
}

TEST_F(ExtiTest, NvicEnableIrq40SetsIser1Bit8) {
